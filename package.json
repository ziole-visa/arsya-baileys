{
  "name": "arsya-baileys",
  "type": "module",
  "version": "9.1.0",
  "description": "Arsya's modded Baileys v7 — interactive messages, album, newsletter, VoIP, anti-lag send queue, auto decrypt-retry/reconnect & ARich helper",
  "author": "Arsya",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*",
    "WAProto/**/*"
  ],
  "scripts": {
    "build": "node -e \"const{execSync:e}=require('child_process');try{e('npx tsc -P tsconfig.build.json',{stdio:'inherit'})}catch(x){};e('npx tsc-esm-fix --tsconfig=tsconfig.build.json --ext=.js',{stdio:'inherit'})\"",
    "test": "node --input-type=module -e \"import('./lib/index.js').then(m=>{const need=['makeWASocket','ARich','ORich','AIRich','Dugong','SendQueue','AutoReconnect'];for(const k of need){if(!(k in m))throw new Error('missing export: '+k)};console.log('exports ok:',need.join(', '))}).catch(e=>{console.error(e);process.exit(1)})\""
  },
  "keywords": [
    "baileys",
    "whatsapp",
    "whatsapp-api",
    "whatsapp-bot",
    "arsya-md",
    "arsya",
    "multi-device",
    "bot",
    "automation",
    "interactive-messages",
    "voip",
    "voice-call",
    "anti-lag",
    "rate-limit"
  ],
  "dependencies": {
    "@cacheable/node-cache": "^1.4.0",
    "@hapi/boom": "^9.1.3",
    "async-mutex": "^0.5.0",
    "fflate": "^0.8.0",
    "libsignal": "^6.0.0",
    "lru-cache": "^11.1.0",
    "music-metadata": "^11.7.0",
    "p-queue": "^9.0.0",
    "pino": "^9.6",
    "protobufjs": "^7.2.4",
    "whatsapp-rust-bridge": "0.5.2",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "@types/ws": "^8.0.0",
    "javascript-obfuscator": "^5.4.1",
    "link-preview-js": "^3.0.0",
    "protobufjs-cli": "^2.0.1",
    "tsc-esm-fix": "^3.1.2",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "@roamhq/wrtc": "*",
    "audio-decode": "^2.1.3",
    "jimp": "^1.6.0",
    "link-preview-js": "^3.0.0",
    "sharp": "*"
  },
  "peerDependenciesMeta": {
    "@roamhq/wrtc": {
      "optional": true
    },
    "audio-decode": {
      "optional": true
    },
    "jimp": {
      "optional": true
    },
    "link-preview-js": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
